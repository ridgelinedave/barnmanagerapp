{
  "name": "crouse-barn-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-placeholder-icons.mjs",
    "check:leak": "node scripts/check-service-key-leak.mjs",
    "db:probe": "node --env-file=.env.local scripts/probe-supabase.mjs",
    "db:combine": "node scripts/build-combined-migration.mjs",
    "db:seed": "node --env-file=.env.local supabase/seed/seed.mjs",
    "test:policies": "node --env-file=.env.local tests/policies.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:leak"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
