# =============================================================================
# Crouse Barn App — environment variables
#
# Copy to .env.local and replace every value. .env.local is gitignored.
#   cp .env.example .env.local        (PowerShell: Copy-Item .env.example .env.local)
#
# Where the values come from: Supabase Dashboard → Project Settings → API.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — inlined into the browser bundle. Safe to expose.
# -----------------------------------------------------------------------------

# Supabase Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co

# The anon / publishable key. This is the ONLY Supabase key the browser ever
# holds. It is public by design — Row Level Security, not this key, is what
# stops one family reading another's data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# -----------------------------------------------------------------------------
# SECRET — server-side only. NEVER prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# The service_role / secret key. It BYPASSES Row Level Security entirely —
# anyone holding it can read and write every row in the database.
#
# Rules:
#   * only read inside lib/supabase/admin.ts (marked `import "server-only"`)
#     and in terminal scripts such as the seed;
#   * never imported by a client component;
#   * in production it lives in the host's encrypted env vars, not in a file.
# `npm run check:leak` fails the build if it reaches a client bundle.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Shared password for the three seeded fixture users. Leave unset and the seed
# generates a random one, recording it in supabase/seed/seed-output.json
# (gitignored), which the policy tests read.
# SEED_TEST_PASSWORD=

# Set to "true" to keep the temporary dev role switcher visible. It is hard
# disabled in production builds regardless of this value.
# NEXT_PUBLIC_DEV_ROLE_SWITCHER=true
