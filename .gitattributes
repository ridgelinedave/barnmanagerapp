# Normalise line endings. Developed on Windows, built on Linux CI and hosted on
# Linux — committing CRLF would produce spurious diffs and can break shebang
# scripts. Working copies stay native; the repo stores LF.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff  binary
*.woff2 binary
